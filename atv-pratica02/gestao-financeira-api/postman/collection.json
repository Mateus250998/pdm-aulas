{
  "info": {
    "name": "Gestão Financeira API",
    "_postman_id": "b1b1ccf4-9d77-4c79-8a2e-gestao-financeira",
    "description": "Collection para testar a API de gestão financeira: health-check, categorias, transações e validações.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "incomeCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "newCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health-check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Resposta deve indicar API saudável', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.ok).to.eql(true);",
              "  pm.expect(json.name).to.eql('gestao-financeira-api');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Listar categorias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Deve retornar lista de categorias', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an('array');",
              "});",
              "",
              "pm.test('Deve encontrar categoria income e salvar o id', function () {",
              "  const json = pm.response.json();",
              "  const income = json.find((category) => category.name === 'income');",
              "  pm.expect(income).to.exist;",
              "  pm.collectionVariables.set('incomeCategoryId', income.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Criar nova categoria",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"health\",\n  \"displayName\": \"Saúde\",\n  \"icon\": \"favorite\",\n  \"background\": \"#FFB6B6\",\n  \"isIncome\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Deve criar categoria e salvar o id', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json.name).to.eql('health');",
              "  pm.collectionVariables.set('newCategoryId', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Atualizar categoria",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"Saúde e Bem-estar\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/categories/{{newCategoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories",
            "{{newCategoryId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Deve atualizar displayName', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.displayName).to.eql('Saúde e Bem-estar');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Excluir categoria criada",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{newCategoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories",
            "{{newCategoryId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Tentar excluir categoria padrão",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories/{{incomeCategoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories",
            "{{incomeCategoryId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Deve bloquear exclusão de categoria padrão', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.eql('Categorias padrão não podem ser excluídas');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Criar transação",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Salário de outubro\",\n  \"value\": 3500.50,\n  \"date\": \"2026-04-29\",\n  \"categoryId\": \"{{incomeCategoryId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Deve criar transação com categoria aninhada', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json).to.have.property('category');",
              "  pm.expect(json.category.name).to.eql('income');",
              "  pm.collectionVariables.set('transactionId', json.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. Listar transações",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Deve retornar lista de transações', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "9. Listar transações com filtro mês/ano",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transactions?month=4&year=2026",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ],
          "query": [
            {
              "key": "month",
              "value": "4"
            },
            {
              "key": "year",
              "value": "2026"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 200', function () {",
              "  pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10. Excluir transação",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/transactions/{{transactionId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions",
            "{{transactionId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "11. Validar erro em transação inválida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transactions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status deve ser 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Deve retornar erro Dados inválidos com details', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.eql('Dados inválidos');",
              "  pm.expect(json.details).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}